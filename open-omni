#!/usr/bin/env bash
set -e

# ─── posta.ai: Developer & AI Agent Environment Script ────────────────
# Este script orquestra as ferramentas locais de desenvolvimento:
# 1. Backend Docker (via ./backend-init)
# 2. OmniRoute daemon (otimização de tokens para agentes de IA)
# 3. Expo Metro bundler (com IP Tailscale para testar no dispositivo)
# 4. OpenCode TUI (interface interativa)

# Carrega shims do mise se disponível para garantir acesso aos binários
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims 2>/dev/null)" || true
fi
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

EXPO_PID_FILE=".expo/expo.pid"
EXPO_LOG_FILE=".expo/expo.log"
mkdir -p .expo

is_expo_running() {
  if [ -f "$EXPO_PID_FILE" ] && kill -0 "$(cat "$EXPO_PID_FILE")" 2>/dev/null; then
    return 0
  fi
  if lsof -ti :8081 >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

SCRIPT_NAME="$(basename "$0")"

# ─── 1. Parar serviços de desenvolvimento ─────────────────────────────
if [ "$1" = "--stop" ] || [ "$1" = "stop" ] || [ "$SCRIPT_NAME" = "stop-omni" ] || [ "$SCRIPT_NAME" = "stop-omni.sh" ]; then
  echo "Encerrando Expo Metro..."
  if [ -f "$EXPO_PID_FILE" ]; then
    EXPO_PID=$(cat "$EXPO_PID_FILE")
    if kill -0 "$EXPO_PID" 2>/dev/null; then
      kill "$EXPO_PID" 2>/dev/null || true
    fi
    rm -f "$EXPO_PID_FILE"
  fi
  fuser -k 8081/tcp >/dev/null 2>&1 || true

  echo "Encerrando OmniRoute..."
  omniroute stop 2>/dev/null || true

  if [ "$2" = "--all" ] || [ "$1" = "--all" ]; then
    echo "Encerrando containers do backend..."
    ./backend-init --stop 2>/dev/null || true
  fi

  echo "Ambiente de desenvolvimento encerrado com sucesso."
  exit 0
fi

# ─── 2. Status dos serviços de desenvolvimento ───────────────────────
if [ "$1" = "--status" ] || [ "$1" = "status" ]; then
  echo "=== OmniRoute ==="
  omniroute status 2>/dev/null || echo "OmniRoute não está em execução."
  echo ""
  echo "=== Expo Metro ==="
  if is_expo_running; then
    echo "🟢 Expo em execução na porta 8081."
    [ -f "$EXPO_PID_FILE" ] && echo "PID: $(cat "$EXPO_PID_FILE")"
    echo "Logs: $EXPO_LOG_FILE"
  else
    echo "🔴 Expo não está em execução."
  fi
  echo ""
  echo "=== Backend Docker ==="
  ./backend-init --status 2>/dev/null || echo "Backend Docker não verificado."
  exit 0
fi

# ─── 3. Inicialização dos Serviços de Dev ─────────────────────────────

# 3.1. Inicia o Backend Docker se o script estiver presente
if [ -f "./backend-init" ]; then
  echo "Verificando Backend Docker..."
  if ! curl -s http://localhost:8000/health 2>/dev/null | grep -q "ok"; then
    echo "Iniciando backend via ./backend-init..."
    ./backend-init || true
  else
    echo "🟢 Backend já está respondendo em http://localhost:8000."
  fi
fi

# 3.2. Inicia o OmniRoute como daemon se ainda não estiver ativo
if command -v omniroute >/dev/null 2>&1; then
  if omniroute health 2>/dev/null | grep -q "Status: healthy"; then
    echo "OmniRoute já está em execução e saudável."
  else
    echo "Iniciando OmniRoute em segundo plano..."
    omniroute serve --daemon --no-open 2>/dev/null || true
    retries=10
    while [ $retries -gt 0 ]; do
      if omniroute health 2>/dev/null | grep -q "Status: healthy"; then
        break
      fi
      sleep 0.5
      retries=$((retries - 1))
    done
  fi
  echo "OmniRoute pronto em http://localhost:20128"
else
  echo "Aviso: 'omniroute' não encontrado no PATH."
fi

# 3.3. Inicia o Expo em segundo plano se ainda não estiver em execução
if is_expo_running; then
  echo "Expo já está em execução na porta 8081."
else
  echo "Iniciando Expo (HOST: 100.110.221.21) em segundo plano..."
  nohup env REACT_NATIVE_PACKAGER_HOSTNAME=100.110.221.21 bun expo start -c > "$EXPO_LOG_FILE" 2>&1 &
  echo $! > "$EXPO_PID_FILE"
  echo "Expo iniciado (PID: $(cat "$EXPO_PID_FILE"), logs em $EXPO_LOG_FILE)."
fi

# 3.4. Se solicitado apenas os serviços de dev, finaliza aqui
if [ "$1" = "--no-opencode" ] || [ "$1" = "--services-only" ]; then
  echo ""
  echo "Serviços de desenvolvimento prontos!"
  echo "Para encerrar, execute: ./stop-omni"
  exit 0
fi

# 3.5. Inicia o OpenCode
if command -v opencode >/dev/null 2>&1; then
  echo "Iniciando OpenCode..."
  echo "---"
  exec opencode --auto "$@"
else
  echo "OpenCode não encontrado. Serviços mantidos em execução."
fi
