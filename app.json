{
  "expo": {
    "name": "posta-ai-app",
    "slug": "posta-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "postaaiapp",
    "userInterfaceStyle": "dark",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004643",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#004643",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O posta.ai precisa acessar suas fotos para você adicionar imagens aos seus produtos.",
          "cameraPermission": "O posta.ai precisa acessar a câmera para você fotografar seus produtos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O posta.ai precisa acessar a câmera para você fotografar seus produtos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7d64d60-78da-4abc-9bde-b1c4832e0c8a"
      }
    },
    "owner": "eduardorwll-apps"
  }
}
